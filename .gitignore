# Secrets — never commit
.env

# Runtime data (regenerated on startup)
vocalpay.db
vocalpay.db-journal

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# OS/editor cruft
.DS_Store
Thumbs.db

# Claude Code local session state
.claude/
.neon
node_modules/

# Mobile (Capacitor/Android) build — see mobile/README.md
mobile/node_modules/
mobile/android/build/
mobile/android/app/build/
mobile/android/.gradle/
mobile/android/capacitor-cordova-android-plugins/build/
mobile/android/local.properties
mobile/dist/
mobile/tw-input.css
# Large binary assets fetched once per mobile/README.md, not re-fetched by any build step
mobile/www/models/
mobile/www/vendor/*.wasm
