# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# Required — Stripe test-mode secret key (sk_test_...), from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Optional — only needed in production (Render). When unset, the app uses a
# local SQLite file instead, which is fine for local dev/tests. See
# PROJECT_STATUS.md §2b.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional — only needed to use the support chatbot (§2c/§2d). No cloud LLM
# API is used anywhere in this app -- it talks to a self-hosted Ollama
# server you run yourself (e.g. Qwen 2.5). Without a reachable
# OLLAMA_BASE_URL, /support/chat returns a clear connection error instead of
# crashing. Run Ollama locally (https://ollama.com) and `ollama pull
# qwen2.5:7b-instruct` to use this on your own machine.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Set to 1 to let Llama propose payment parameters before the regex parser (fallback stays on)
NLU_LLAMA=0

# Optional — only needed to use passkeys (WebAuthn/FIDO2, §2e) as an
# additional step-up method alongside the PIN. RP_ID must exactly match the
# domain serving the frontend (no scheme/port); ORIGIN is the exact
# scheme+host the browser sends. Defaults below are for local dev on
# 127.0.0.1:8001 — override both for production (e.g. RP_ID=
# vocalpay.onrender.com, ORIGIN=https://vocalpay.onrender.com).
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=VocalPay
# WEBAUTHN_ORIGIN=http://localhost:8001

# Optional — local speech-to-text model size for /voice/transcribe (§2f).
# Bigger = more accurate, slower first-run download. Needs real CPU/RAM this
# app's free Render tier doesn't have; works fine for local dev.
# WHISPER_MODEL_SIZE=tiny.en
