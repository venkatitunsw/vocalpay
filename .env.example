# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# Required — Stripe test-mode secret key (sk_test_...), from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Optional — only needed in production (Render). When unset, the app uses a
# local SQLite file instead, which is fine for local dev/tests. See
# PROJECT_STATUS.md §2b.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional — only needed to use the support chatbot (§2c). From
# https://aistudio.google.com/apikey. Without it, /support/chat returns a
# clear "Missing GEMINI_API_KEY" error instead of crashing.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
