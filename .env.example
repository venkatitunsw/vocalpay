# Copy this file to .env and fill in real values. .env itself is gitignored
# and must never be committed.

# Required — Stripe test-mode secret key (sk_test_...), from
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=

# Postgres connection. The default matches docker-compose.yml (local Postgres on
# port 5433). Production uses a Neon connection string set in the Render dashboard.
DATABASE_URL=postgresql://vocalpay:vocalpay@localhost:5433/vocalpay

# Optional — only needed to use the support chatbot. No cloud LLM API is used
# anywhere in this app: it talks to a self-hosted Ollama server you run
# yourself (Llama 3.1 8B). Without a reachable OLLAMA_BASE_URL, /support/chat
# returns a clear connection error. Run `ollama pull llama3.1:8b` to use it.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Set to 1 to let Llama propose payment parameters before the regex parser (fallback stays on)
NLU_LLAMA=0

# Optional — only needed to use passkeys (WebAuthn/FIDO2, §2e) as an
# additional step-up method alongside the PIN. RP_ID must exactly match the
# domain serving the frontend (no scheme/port); ORIGIN is the exact
# scheme+host the browser sends. Defaults below are for local dev on
# 127.0.0.1:8001 — override both for production (e.g. RP_ID=
# vocalpay.onrender.com, ORIGIN=https://vocalpay.onrender.com).
# WEBAUTHN_RP_ID=localhost
# WEBAUTHN_RP_NAME=VocalPay
# WEBAUTHN_ORIGIN=http://localhost:8001

